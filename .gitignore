# Godot editor state, imported cache and local export credentials.
# Keep project.godot, export_presets.cfg, *.import sidecars and *.uid files.
.godot/
.import/
/export.cfg
/export_credentials.cfg
*.translation

# Local builds and root-level Windows exports.
/build/
/*.exe
/*.pck
/*.exe.new
/*.exe.previous
/data_*/

# Local test evidence. Keep test scripts and fixtures under tests/ and qa/.
/test_evidence/

# Blender backup copies, Python bytecode and Mono caches.
*.blend[0-9]
*.blend[0-9][0-9]
__pycache__/
*.pyc
.mono/
mono_crash.*.json

# OS thumbnail and folder metadata.
Thumbs.db
.DS_Store
